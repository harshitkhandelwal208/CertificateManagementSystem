# Copy to .env.local for Next.js. Export the same variables in the shell running
# the .NET engine and verifier; dotnet does not load .env.local automatically.
# Use a local PostgreSQL URI or the Neon pooled URI. Never commit real secrets.
DATABASE_URL=postgresql://certificate_app:replace-me@localhost:5432/certificates
ADMIN_EMAIL=
ADMIN_PASSWORD=
SESSION_SECRET=
Platform__InternalApiKey=
Platform__OrganizationName=Clinically Evolve Foundation
Platform__PublicBaseUrl=http://localhost:3000
Platform__DataDirectory=data
Signing__Enabled=true
Signing__PfxPath=data/ca/signing.pfx
Signing__PfxPassword=
Signing__TrustedRootPath=data/ca/root-ca.pem
Verification__TrustedRootPath=data/ca/root-ca.pem
VERIFICATION_URL=http://localhost:5001
