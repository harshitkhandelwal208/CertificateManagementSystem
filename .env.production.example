# Configure these in Render's Environment tab. Do not commit populated files.
# DATABASE_URL is the same Neon PostgreSQL URI for Next.js, signer and verifier.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require
ADMIN_EMAIL=
ADMIN_PASSWORD=
SESSION_SECRET=
Platform__InternalApiKey=
Platform__OrganizationName=Clinically Evolve Foundation
Signing__PfxPassword=
SIGNING_PFX_BASE64=
TRUSTED_ROOT_PEM_BASE64=
# Render supplies RENDER_EXTERNAL_URL. For a custom domain, set:
# Platform__PublicBaseUrl=https://certificates.example.org
