# ==============================================================================
# Backend Secrets & Runtime Environment Variables (CertificateEngine)
# Copy this file to secrets.env or set these in your environment / systemd unit.
# DO NOT commit real secrets or private passwords to version control!
# ==============================================================================

# Root CA Private Key Password (Keep secret; move root-ca.pfx to offline/cold storage)
CA_ROOT_PASSWORD=replace-with-a-long-random-password

# Signing PFX Password used by CertificateEngine
CA_SIGNING_PASSWORD=replace-with-a-long-random-password

# Application runtime environment variable for Signing PFX password
Signing__PfxPassword=replace-with-a-long-random-password

# Shared API key for internal administration endpoint (header: X-Api-Key)
Platform__InternalApiKey=replace-with-a-long-random-32-char-api-key

# Optional: Google Sheets Service Account Credentials
# GoogleSheets__ServiceAccountJsonPath=/etc/certificate-engine/service-account.json

# SMTP credential (MailKit/Resend). Supply at runtime; never commit or log it.
# Smtp__Password=replace-with-resend-api-key

# Optional: WhatsApp Cloud API Credentials
# WhatsApp__AccessToken=replace-with-meta-access-token

# ==============================================================================
# Frontend Environment Variables (Next.js BFF)
# ==============================================================================
ENGINE_URL=http://localhost:5000
ENGINE_API_KEY=replace-with-a-long-random-32-char-api-key
VERIFICATION_URL=http://localhost:5001
NEXT_PUBLIC_APP_URL=http://localhost:3000
